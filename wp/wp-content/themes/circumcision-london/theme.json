{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "780px",
			"wideSize": "1220px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"palette": [
				{ "slug": "paper", "color": "#f4f7fa", "name": "Paper" },
				{ "slug": "paper-2", "color": "#e8eff6", "name": "Paper 2" },
				{ "slug": "card", "color": "#ffffff", "name": "Card" },
				{ "slug": "ink", "color": "#16202e", "name": "Ink" },
				{ "slug": "ink-2", "color": "#1b2735", "name": "Ink 2" },
				{ "slug": "muted", "color": "#55637a", "name": "Muted" },
				{ "slug": "muted-2", "color": "#7e8ba0", "name": "Muted 2" },
				{ "slug": "line", "color": "#d9e3ee", "name": "Line" },
				{ "slug": "line-2", "color": "#e8eff6", "name": "Line 2" },
				{ "slug": "blue", "color": "#1d5fa0", "name": "Blue" },
				{ "slug": "blue-deep", "color": "#17497c", "name": "Blue deep" },
				{ "slug": "blue-soft", "color": "#e7f0f9", "name": "Blue soft" },
				{ "slug": "amber", "color": "#b4642f", "name": "Amber" },
				{ "slug": "footer", "color": "#12243a", "name": "Footer" },
				{ "slug": "urgent", "color": "#fdf1e8", "name": "Urgent" },
				{ "slug": "white", "color": "#ffffff", "name": "White" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"dropCap": false,
			"fluid": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Karla\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
					"slug": "sans",
					"name": "Karla",
					"fontFace": [
						{
							"fontFamily": "Karla",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/karla-normal-latin.woff2" ]
						},
						{
							"fontFamily": "Karla",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/karla-normal-latinext.woff2" ]
						}
					]
				},
				{
					"fontFamily": "\"Newsreader\", Georgia, \"Times New Roman\", serif",
					"slug": "display",
					"name": "Newsreader",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/newsreader-normal-latin.woff2" ]
						},
						{
							"fontFamily": "Newsreader",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/newsreader-normal-latinext.woff2" ]
						},
						{
							"fontFamily": "Newsreader",
							"fontWeight": "200 800",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/newsreader-italic-latin.woff2" ]
						},
						{
							"fontFamily": "Newsreader",
							"fontWeight": "200 800",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/newsreader-italic-latinext.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "12px", "name": "Caps" },
				{ "slug": "medium", "size": "17px", "name": "Body" },
				{ "slug": "large", "size": "clamp(18px, 1.5vw, 21px)", "name": "Lede" },
				{ "slug": "x-large", "size": "clamp(20px, 1.9vw, 26px)", "name": "Display 3" },
				{ "slug": "xx-large", "size": "clamp(25px, 2.8vw, 38px)", "name": "Display 2" },
				{ "slug": "huge", "size": "clamp(30px, 4vw, 52px)", "name": "Display 1" },
				{ "slug": "hero", "size": "clamp(38px, 6.2vw, 76px)", "name": "Hero" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "size": "12px", "name": "12" },
				{ "slug": "30", "size": "18px", "name": "18" },
				{ "slug": "40", "size": "24px", "name": "24" },
				{ "slug": "50", "size": "clamp(20px, 5vw, 60px)", "name": "Gap" },
				{ "slug": "60", "size": "clamp(44px, 5.5vw, 84px)", "name": "Section small" },
				{ "slug": "70", "size": "clamp(64px, 8vw, 132px)", "name": "Section" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false
		},
		"custom": {
			"radius": "4px",
			"radiusCard": "6px",
			"headerHeight": "80px",
			"ease": "cubic-bezier(.22, .61, .36, 1)"
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"h1": {
				"color": { "text": "var(--wp--preset--color--ink-2)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--huge)",
					"fontWeight": "300",
					"letterSpacing": "-0.012em",
					"lineHeight": "1.12"
				}
			},
			"h2": {
				"color": { "text": "var(--wp--preset--color--ink-2)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "300",
					"letterSpacing": "-0.012em",
					"lineHeight": "1.16"
				}
			},
			"h3": {
				"color": { "text": "var(--wp--preset--color--ink-2)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "300",
					"letterSpacing": "-0.012em",
					"lineHeight": "1.22"
				}
			},
			"h4": {
				"color": { "text": "var(--wp--preset--color--ink-2)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.3"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--blue-deep)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--blue)" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--blue)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"color": "var(--wp--preset--color--blue)",
					"radius": "4px",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "15px",
					"fontWeight": "600",
					"letterSpacing": "0.01em"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"right": "26px",
						"bottom": "14px",
						"left": "26px"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted-2)" },
				"typography": {
					"fontSize": "14px"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.78"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "clamp(19px, 1.6vw, 22px)",
					"fontStyle": "italic",
					"fontWeight": "300",
					"lineHeight": "1.46"
				},
				"color": {
					"text": "var(--wp--preset--color--ink-2)"
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--line)"
				}
			}
		}
	}
}
