    "content": "<!-- wp:cil/page-head {\"eyebrow\":\"Written instructions · Videos · Follow-up\",\"title\":\"Circumcision aftercare\",\"lede\":\"Good aftercare is an important part of the service. Before you leave the clinic, we explain what to expect, show you what you need to do and give you written instructions. Preparation and aftercare videos are also available for the relevant age group and method.\",\"reviewedBy\":\"\\u003ca href=\\u0022https://circumcision-london-wp.vercel.app/team/#haidar\\u0022\\u003eDr Haidar Al-Ali, BDS, MFDS RCPS (Glasg)\\u003c/a\\u003e, September 2026\",\"crumbs\":[{\"label\":\"Aftercare\",\"href\":\"\"}]} /-->\n\n<!-- wp:cil/section {\"size\":\"section-sm\",\"band\":\"\",\"wrap\":\"wrap-narrow\"} --><section class=\"wp-block-cil-section section-sm\"><div class=\"wrap-narrow\"><!-- wp:cil/callout {\"title\":\"If this is urgent, do not wait for an appointment\",\"body\":\"\\u003cp style=\\u0022margin-top:10px\\u0022\\u003eGo to A\\u0026amp;E today if a pulled-back foreskin is trapped behind the head of the penis and swelling, if you or your child cannot pass urine, or if there is spreading redness with a fever. Those need treating in hours. For anything else, call \\u003ca href=\\u0022tel:+442089513794\\u0022 data-track=\\u0022call-urgent\\u0022 style=\\u0022color:var(\\u002d\\u002dblue-deep);font-weight:600\\u0022\\u003e020 8951 3794\\u003c/a\\u003e and tell us what is happening, and we will bring you forward if you need it.\\u003c/p\\u003e\",\"urgent\":true,\"level\":2} /--></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section-sm\",\"band\":\"bg-card edge\",\"wrap\":\"wrap\"} --><section class=\"wp-block-cil-section section-sm bg-card edge\"><div class=\"wrap\"><!-- wp:cil/section-head {\"eyebrow\":\"Overview\",\"heading\":\"Aftercare topics covered by the clinic\",\"lede\":\"This page is an overview. Do not treat it as a substitute for the clinic's current aftercare sheets and videos.\",\"display\":\"d-2\"} /--><!-- wp:cil/info-cards {\"items\":[{\"title\":\"Baby/toddler ring-method aftercare\",\"body\":\"Written instructions and videos are provided for the Plastibell or Circumplast ring method. See also the \\u003ca href=\\u0022https://circumcision-london-wp.vercel.app/babies/\\u0022\\u003ebabies and toddlers\\u003c/a\\u003e page.\"},{\"title\":\"Children's forceps-guided aftercare\",\"body\":\"Aftercare for older children is explained before you leave. See the \\u003ca href=\\u0022https://circumcision-london-wp.vercel.app/children/\\u0022\\u003echildren and teenagers\\u003c/a\\u003e page.\"},{\"title\":\"Adult forceps-guided aftercare\",\"body\":\"Adult aftercare is given in writing before you leave. See the \\u003ca href=\\u0022https://circumcision-london-wp.vercel.app/adults/\\u0022\\u003eadult circumcision\\u003c/a\\u003e page.\"},{\"title\":\"Nappies or underwear\",\"body\":\"Guidance on nappies or underwear is included in the written instructions for the method used.\"},{\"title\":\"Cleaning and keeping the area dry\",\"body\":\"The clinic shows you what you need to do and gives you written instructions before you leave.\"},{\"title\":\"What normal healing can look like\",\"body\":\"Preparation and aftercare videos are available for the relevant age group and method.\"},{\"title\":\"What to do if there is bleeding\",\"body\":\"Follow the written aftercare sheet given to you. Contact the clinic if you are concerned.\"},{\"title\":\"Special advice for a buried penis\",\"body\":\"See the \\u003ca href=\\u0022https://circumcision-london-wp.vercel.app/buried-penis/\\u0022\\u003eburied penis\\u003c/a\\u003e page and follow the method-specific instructions given at the clinic.\"},{\"title\":\"When to contact the clinic\",\"body\":\"We contact patients or parents the day after the circumcision to check progress and understanding of the aftercare. Follow-up appointments during the healing period are included where needed.\"}]} /--></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-warm\",\"wrap\":\"wrap\"} --><section class=\"wp-block-cil-section section bg-warm\"><div class=\"wrap\"><!-- wp:cil/split {\"reverse\":false} --><div class=\"wp-block-cil-split split\"><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:cil/rich-html {\"html\":\"\\u003cspan class=\\u0022caps eyebrow\\u0022\\u003eWhen to seek urgent help\\u003c/span\\u003e\"} /--><!-- wp:heading {\"level\":2,\"className\":\"display d-1\"} --><h2 class=\"wp-block-heading display d-1\">Emergency contact</h2><!-- /wp:heading --><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:paragraph --><p>Use the emergency contact instructions supplied by the clinic if you are concerned after a procedure. If there is a medical emergency and the clinic cannot be reached, use the appropriate NHS emergency service and take the aftercare information with you.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:cil/rich-html {\"html\":\"\\u003cspan class=\\u0022caps eyebrow\\u0022\\u003eReaching us\\u003c/span\\u003e\"} /--><!-- wp:heading {\"level\":2,\"className\":\"display d-2\"} --><h2 class=\"wp-block-heading display d-2\">Who to call, and when</h2><!-- /wp:heading --><!-- wp:cil/rich-html {\"html\":\"\\u003cdl class=\\u0022spec\\u0022\\u003e\\n\\t\\t\\t\\u003c/dl\\u003e\"} /--><!-- wp:cil/rich-html {\"html\":\"\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eDuring opening hours\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003e\\u003ca href=\\u0022tel:+442089513794\\u0022 data-track=\\u0022call-aftercare\\u0022 style=\\u0022color:var(\\u002d\\u002dblue-deep);text-decoration:none\\u0022\\u003e020 8951 3794\\u003c/a\\u003e\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\"} /--><!-- wp:cil/rich-html {\"html\":\"\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eOut of hours\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003eThe number on your aftercare sheet\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\"} /--><!-- wp:cil/rich-html {\"html\":\"\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eBy message\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003e\\u003ca href=\\u0022https://wa.me/447886779958\\u0022 rel=\\u0022noopener\\u0022 target=\\u0022_blank\\u0022 data-track=\\u0022whatsapp-aftercare\\u0022 style=\\u0022color:var(\\u002d\\u002dblue-deep);text-decoration:none\\u0022\\u003eWhatsApp\\u003c/a\\u003e\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\"} /--><!-- wp:cil/rich-html {\"html\":\"\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eCannot reach us\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003eA\\u0026amp;E, or 111 for advice\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\"} /--><!-- wp:cil/rich-html {\"html\":\"\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eNext-day call\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003eWe ring you, you do not chase us\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\"} /--><!-- wp:cil/rich-html {\"html\":\"\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eFollow-up visits\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003eIncluded until healed\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\"} /--><!-- wp:paragraph --><p class=\"muted\" style=\"margin-top:16px;font-size:15px\">Photographs sent on WhatsApp are genuinely useful and\n          we are asked for that constantly. Send one if it helps.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:group --></div><!-- /wp:cil/split --></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/cta-band {\"title\":\"Already had the procedure and something is worrying you?\",\"text\":\"Call the clinic. Follow-up appointments during the healing period are included where needed.\",\"eyebrow\":\"Talk to us\",\"ctaLabel\":\"Book a consultation\",\"ctaUrl\":\"https://circumcision-london-wp.vercel.app/book/\",\"phoneLabel\":\"Call 020 8951 3794\",\"phoneUrl\":\"tel:+442089513794\",\"cardTitle\":\"Would you rather write than speak?\",\"cardHtml\":\"\\u003cp style=\\u0022margin-top:10px\\u0022\\u003eA phone call asks you to be fluent and composed in the moment. \\u003ca href=\\u0022https://wa.me/447886779958\\u0022 rel=\\u0022noopener\\u0022 target=\\u0022_blank\\u0022 data-track=\\u0022whatsapp-cta\\u0022 style=\\u0022color:var(\\u002d\\u002dblue-deep)\\u0022\\u003eWhatsApp\\u003c/a\\u003e does not. You can take your time, translate, and forward the answer to whoever else in the family needs to see it.\\u003c/p\\u003e\\u003cp style=\\u0022margin-top:12px\\u0022\\u003eWe reply during opening hours, and we are used to the questions people feel awkward asking out loud.\\u003c/p\\u003e\"} /-->"
}
