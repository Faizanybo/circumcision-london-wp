":\"\",\"cta2Class\":\"btn btn-ghost\"}],\"columns\":\"g-3\",\"headingLevel\":2} /--></div></section>\n<!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-card edge\"} -->\n<section class=\"wp-block-cil-section section bg-card edge\"><div class=\"wrap\"><!-- wp:cil/split -->\n<div class=\"wp-block-cil-split split\"><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:cil/rich-html {\"html\":\"\\u003cspan class=\\u0022caps eyebrow\\u0022\\u003eGetting here\\u003c/span\\u003e\"} /--><!-- wp:heading {\"level\":2,\"className\":\"display d-1\"} --><h2 class=\"wp-block-heading display d-1\">Directions</h2><!-- /wp:heading --><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:paragraph --><p><strong>By Underground.</strong> Queensbury station on the Jubilee line is on the same road as the clinic (8 mins walk). Burnt Oak station on the Northern line is also within walking distance (20 mins walk).</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><strong>By car.</strong> Plenty of free on-street parking. The clinic is outside the Congestion Charge zone.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><strong>By bus and from airports.</strong> Buses 79, 114 and 302 stop within walking distance. Approximate driving times are 40 minutes from London Luton Airport and 50 minutes from Heathrow, depending on traffic.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:cil/rich-html {\"html\":\"\\u003ca class=\\u0022btn\\u0022 href=\\u0022https://www.google.com/maps/search/?api=1\\u0026amp;query=78%20Beverley%20Drive%2C%20Edgware%20HA8%205NE\\u0022 rel=\\u0022noopener\\u0022 target=\\u0022_blank\\u0022 data-track=\\u0022map-directions\\u0022\\u003eGet directions\\u003c/a\\u003e\"} /--><!-- wp:cil/rich-html {\"html\":\"\\u003ca class=\\u0022btn btn-ghost\\u0022 href=\\u0022tel:+442089513794\\u0022 data-track=\\u0022call-directions\\u0022\\u003eCall 020 8951 3794\\u003c/a\\u003e\"} /--></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:cil/rich-html {\"html\":\"\\u003ca href=\\u0022https://www.google.com/maps/search/?api=1\\u0026amp;query=78%20Beverley%20Drive%2C%20Edgware%20HA8%205NE\\u0022 rel=\\u0022noopener\\u0022 target=\\u0022_blank\\u0022 data-track=\\u0022map-static\\u0022 style=\\u0022display:block;text-decoration:none;border:1px solid var(\\u002d\\u002dline);border-radius:6px;background:var(\\u002d\\u002dpaper-2);padding:clamp(26px,3vw,40px)\\u0022\\u003e\\n          \\u003cspan class=\\u0022caps\\u0022 style=\\u0022color:var(\\u002d\\u002dblue)\\u0022\\u003eLocation\\u003c/span\\u003e\\n          \\u003cspan class=\\u0022display d-2\\u0022 style=\\u0022display:block;margin-top:12px\\u0022\\u003eEdgware, HA8 5NE\\u003c/span\\u003e\\n          \\u003cspan class=\\u0022muted\\u0022 style=\\u0022display:block;margin-top:14px;font-size:16px;line-height:1.7\\u0022\\u003e\\n            78 Beverley Drive, Edgware, London HA8 5NE.\\u003cbr\\u003e\\n            Eight minutes on foot from Queensbury station.\\n          \\u003c/span\\u003e\\n          \\u003cspan class=\\u0022link-arrow\\u0022 style=\\u0022margin-top:22px\\u0022\\u003eOpen in Google Maps\\u003c/span\\u003e\\n        \\u003c/a\\u003e\"} /--><!-- wp:paragraph --><p class=\"muted\" style=\"margin-top:12px;font-size:14.5px\">\n          We link out to Google Maps instead of embedding it, so this page loads immediately and sets no third-party\n          cookie before you have chosen to open the map.\n        </p><!-- /wp:paragraph --></div><!-- /wp:group --></div>\n<!-- /wp:cil/split --></div></section>\n<!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"wrap\":\"wrap-narrow\"} -->\n<section class=\"wp-block-cil-section section\"><div class=\"wrap-narrow\"><!-- wp:cil/callback-card {\"eyebrow\":\"Request a call back\",\"title\":\"Ask us to call you\",\"formId\":\"contact\",\"subject\":\"contact page callback\",\"urgent\":false} /--></div></section>\n<!-- /wp:cil/section -->"
