    "content": "<!-- wp:cil/page-head {\"eyebrow\":\"Edgware · Free parking\",\"title\":\"Visit the clinic\",\"lede\":\"Beverley Clinic, 78 Beverley Drive, Edgware, HA8 5NE, North-West London. Contact the clinic by telephone, mobile, email or online enquiry.\",\"crumbs\":[{\"label\":\"Visit us\",\"href\":\"\"}]} /-->\n\n<!-- wp:cil/section -->\n<section class=\"wp-block-cil-section section-sm\"><div class=\"wrap\"><!-- wp:cil/info-cards {\"items\":[{\"eyebrow\":\"By phone\",\"title\":\"Talk to the clinic\",\"html\":\"\\u003cdl class=\\u0022spec\\u0022\\u003e\\n\\t\\t\\t\\u003c/dl\\u003e\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eClinic\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003e\\u003ca href=\\u0022tel:+442089513794\\u0022 data-track=\\u0022call-contact\\u0022 style=\\u0022color:var(\\u002d\\u002dblue-deep);text-decoration:none\\u0022\\u003e020 8951 3794\\u003c/a\\u003e\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\\n\\t\\t\\t\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eMobile\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003e\\u003ca href=\\u0022tel:+447886779958\\u0022 data-track=\\u0022call-contact-mobile\\u0022 style=\\u0022color:var(\\u002d\\u002dblue-deep);text-decoration:none\\u0022\\u003e07886 779958\\u003c/a\\u003e\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\\n\\t\\t\\t\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eWhatsApp\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003e\\u003ca href=\\u0022https://wa.me/447886779958\\u0022 rel=\\u0022noopener\\u0022 target=\\u0022_blank\\u0022 data-track=\\u0022whatsapp-contact\\u0022 style=\\u0022color:var(\\u002d\\u002dblue-deep);text-decoration:none\\u0022\\u003e07886 779958\\u003c/a\\u003e\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\\n\\t\\t\\t\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eEmail\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003e\\u003ca href=\\u0022mailto