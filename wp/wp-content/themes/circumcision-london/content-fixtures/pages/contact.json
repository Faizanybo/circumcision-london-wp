ailto:info@circumcisioninlondon.co.uk\\u0022 style=\\u0022color:var(\\u002d\\u002dblue-deep);text-decoration:none;font-size:15px\\u0022\\u003einfo@circumcisioninlondon.co.uk\\u003c/a\\u003e\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\",\"ctaLabel\":\"\",\"ctaUrl\":\"\",\"ctaClass\":\"btn\",\"cta2Label\":\"\",\"cta2Url\":\"\",\"cta2Class\":\"btn btn-ghost\"},{\"eyebrow\":\"Opening hours\",\"title\":\"When we are here\",\"html\":\"\\u003cdl class=\\u0022spec\\u0022\\u003e\\n\\t\\t\\t\\u003c/dl\\u003e\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eMonday to Saturday\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003e09:00 \u2013 17:00\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\\n\\t\\t\\t\\u003cli\\u003e\\n\\t\\t\\t\\u003cdt class=\\u0022k\\u0022\\u003eSunday and holidays\\u003c/dt\\u003e\\n\\t\\t\\t\\u003cdd class=\\u0022v\\u0022\\u003ePhone lines closed\\u003c/dd\\u003e\\n\\t\\t\\u003c/li\\u003e\\n\\t\\n\\n        \\u003cp class=\\u0022muted\\u0022 style=\\u0022margin-top:14px;font-size:15px\\u0022\\u003eSundays, public holidays and bank holidays: phone lines are closed, but some pre-booked appointments still go ahead.\\u003c/p\\u003e\",\"ctaLabel\":\"\",\"ctaUrl\":\"\",\"ctaClass\":\"btn\",\"cta2Label\":\"\",\"cta2Url\":\"\",\"cta2Class\":\"btn btn-ghost\"},{\"eyebrow\":\"Where we are\",\"title\":\"Find us\",\"html\":\"\\u003caddress style=\\u0022font-style:normal;margin-top:16px;font-size:17px;line-height:1.8;color:var(\\u002d\\u002dmuted)\\u0022\\u003e78 Beverley Drive\\u003cbr\\u003eEdgware\\u003cbr\\u003eHA8 5NE\\u003c/address\\u003e\\n        \\n        \\u003cp class=\\u0022muted\\u0022 style=\\u0022margin-top:14px;font-size:15px\\u0022\\u003ePlenty of free on-street parking. Outside the Congestion Charge zone.\\u003c/p\\u003e\",\"ctaLabel\":\"Open in Google Maps\",\"ctaUrl\":\"https://www.google.com/maps/search/?api=1\\u0026query=78%20Beverley%20Drive%2C%20Edgware%20HA8%205NE\",\"ctaClass\":\"btn btn-ghost\",\"cta2Label\":\"\",\"cta2Url\":\"\",\"cta2Class\":\"btn btn-ghost\"}],\"columns\":\"g-3\",\"headingLevel\":2} /--></div></section>\n<!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-card edge\"} -->\n<section class=\"wp-block-cil-section section bg-card edge\"><div class=\"wrap\"><!-- wp:cil/split -->\n<div class=\"wp-block-cil-split split\"><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:cil/rich-html {\"html\":\"\\u003cspan class=\\u0022caps eyebrow\\u0022\\u003eGetting here\\u003c/span\\u003e\"} /--><!-- wp:heading {\"level\":2,\"className\":\"display d-1\"} --><h2 class=\"wp-block-heading display d-1\">Directions</h2><!-- /wp:heading --><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:paragraph --><p><strong>By Underground.</strong> Queensbury station on the Jubilee line is on the same road as the clinic (8 mins walk). Burnt Oak station on the Northern line is also within walking distance (20 mins walk).</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><strong>By car.</strong> Plenty of free on-street parking. The clinic is outside the Congestion Charge zone.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><strong>By bus and from airports.</strong> Buses 79, 114 and 302 stop within walking distance. Approximate driving times are 40 minutes from London Luton Airport and 50 minutes from Heathrow, depending on traffic.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:cil/rich-html {\"html\":\"\\u003ca class=\\u0022btn\\u0022 href=\\u0022https://www.google.com/maps/search/?api=1\\u0026amp;query=78%20Beverley%20Drive%2C%20Edgware%20HA8%205NE\\u0022 rel=\\u0022noopener\\u0022 target=\\u0022_blank\\u0022 data-track=\\u0022map-directions\\u0022\\u003eGet directions\\u003c/a\\u003e\"} /--><!-- wp:cil/rich-html {\"html\":\"\\u003ca class=\\u0022btn btn-ghost\\u0022 href=\