    "content": "<!-- wp:cil/page-head {\"eyebrow\":\"By age band · Everything included\",\"title\":\"Circumcision prices\",\"lede\":\"The price includes the procedure, local anaesthetic, preparation/aftercare information, a next-day follow-up call, written aftercare, free follow-up appointments during healing and a GP letter, nursery/ school/ work letter where required.\",\"crumbs\":[{\"label\":\"Prices\",\"href\":\"\"}]} /-->\n\n<!-- wp:cil/section -->\n<section class=\"wp-block-cil-section section-sm\"><div class=\"wrap\"><!-- wp:cil/callout {\"body\":\"\\u003cspan class=\\u0022caps\\u0022 style=\\u0022color:var(\\u002d\\u002dblue-deep)\\u0022\\u003eIncluded in every price on this page\\u003c/span\\u003e\\u003cbr\\u003e      \\u003cul class=\\u0022grid g-2\\u0022 style=\\u0022list-style:none;margin-top:16px;gap:10px 30px\\u0022\\u003e\\u003cbr\\u003e        \\u003cli style=\\u0022display:flex;gap:9px;align-items:flex-start;font-size:16px;color:var(\\u002d\\u002dmuted)\\u0022\\u003e\\u003cspan aria-hidden=\\u0022true\\u0022 style=\\u0022color:var(\\u002d\\u002dblue)\\u0022\\u003e·\\u003c/span\\u003e\\u003cspan\\u003eThe procedure\\u003c/span\\u003e\\u003c/li\\u003e\\u003cli style=\\u0022display:flex;gap:9px;align-items:flex-start;font-size:16px;color:var(\\u002d\\u002dmuted)\\u0022\\u003e\\u003cspan aria-hidden=\\u0022true\\u0022 style=\\u0022color:var(\\u002d\\u002dblue)\\u0022\\u003e·\\u003c/span\\u003e\\u003cspan\\u003eLocal anaesthetic\\u003c/span\\u003e\\u003c/li\\u003e\\u003cli style=\\u0022display:flex;gap:9px;align-items:flex-start;font-size:16px;color:var(\\u002d\\u002dmuted)\\u0022\\u003e\\u003cspan aria-hidden=\\u0022true\\u0022 style=\\u0022color:var(\\u002d\\u002dblue)\\u0022\\u003e·\\u003c/span\\u003e\\u003cspan\\u003ePreparation and aftercare information\\u003c/span\\u003e\\u003c/li\\u003e\\u003cli style=\\u0022display:flex;gap:9px;align-items:flex-start;font-size:16px;color:var(\\u002d\\u002dmuted)\\u0022\\u003e\\u003cspan aria-hidden=\\u0022true\\u0022 style=\\u0022color:var(\\u002d\\u002dblue)\\u0022\\u003e·\\u003c/span\\u003e\\u003cspan\\u003eA next-day follow-up call\\u003c/span\\u003e\\u003c/li\\u003e\\u003cli style=\\u0022display:flex;gap:9px;align-items:flex-start;font-size:16px;color:var(\\u002d\\u002dmuted)\\u0022\\u003e\\u003cspan aria-hidden=\\u0022true\\u0022 style=\\u0022color:var(\\u002d\\u002dblue)\\u0022\\u003e·\\u003c/span\\u003e\\u003cspan\\u003eWritten aftercare\\u003cspan style=\\u0022background-color: rgba(29, 95, 160, 0.2); color: var(\\u002d\\u002dblue);\\u0022\\u003e·\\u003c/span\\u003e\\u003c/span\\u003e\\u003c/li\\u003e\\u003cli style=\\u0022display:flex;gap:9px;align-items:flex-start;font-size:16px;color:var(\\u002d\\u002dmuted)\\u0022\\u003e\\u003cspan\\u003eFree follow-up appointments during healing\\u003c/span\\u003e\\u003c/li\\u003e\\u003cli style=\\u0022display:flex;gap:9px;align-items:flex-start;font-size:16px;color:var(\\u002d\\u002dmuted)\\u0022\\u003e\\u003cspan aria-hidden=\\u0022true\\u0022 style=\\u0022color:var(\\u002d\\u002dblue)\\u0022\\u003e·\\u003c/span\\u003e\\u003cspan\\u003eA GP letter\\u003c/span\\u003e\\u003c/li\\u003e\\u003cli style=\\u0022display:flex;gap:9px;align-items:flex-start;font-size:16px;color:var(\\u002d\\u002dmuted)\\u0022\\u003e\\u003cspan aria-hidden=\\u0022true\\u0022 style=\\u0022color:var(\\u002d\\u002dblue)\\u0022\\u003e·\\u003c/span\\u003e\\u003cspan\\u003eNursery, school or work letter where required\\u003c/span\\u003e\\u003c/li\\u003e\\u003cbr\\u003e      \\u003c/ul\\u003e\\u003cbr\\u003e      \\u003cp class=\\u0022muted\\u0022 style=\\u0022margin-top:16px;font-size:15px\\u0022\\u003eCarried out in a clean, modern clinic registered with\\u003cbr\\u003e      the Care Quality Commission and rated Good.\\u003c/p\\u003e\"} /--></div></section>\n<!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"band\":\"bg-card edge\"} -->\n<section class=\"wp-block-cil-section section-sm bg-card edge\"><div class=\"wrap\"><!-- wp:cil/section-head {\"heading\":\"Babies, children and teenagers\",\"lede\":\"The ring method is commonly used for babies and toddlers. The forceps-guided method is commonly used for older boys. The method is decided after examination.\"} /-->\n\n<!-- wp:cil/price-table {\"rows\":[{\"name\":\"0 to 2 months\",\"price\":\"£200\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=0 to 2 months\",\"cta\":\"Book this\",\"desc\":\"\",\"href\":\"\"},{\"name\":\"3 to 5 months\",\"price\":\"£230\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=3 to 5 months\",\"cta\":\"Book this\",\"desc\":\"\",\"href\":\"\"},{\"name\":\"6 to 11 months\",\"price\":\"£250\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=6 to 11 months\",\"cta\":\"Book this\",\"desc\":\"\",\"href\":\"\"},{\"name\":\"1 to 2 years\",\"price\":\"£280\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=1 to 2 years\",\"cta\":\"Book this\",\"desc\":\"\",\"href\":\"\"},{\"name\":\"3 to 5 years\",\"price\":\"£300\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=3 to 5 years\",\"cta\":\"Book this\",\"desc\":\"\",\"href\":\"\"},{\"name\":\"6 to 9 years\",\"price\":\"£330\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=6 to 9 years\",\"cta\":\"Book this\",\"desc\":\"\",\"href\":\"\"},{\"name\":\"10 to 11 years\",\"price\":\"£360\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=10 to 11 years\",\"cta\":\"Book this\",\"desc\":\"\",\"href\":\"\"},{\"name\":\"12 to 13 years\",\"price\":\"£400\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=12 to 13 years\",\"cta\":\"Book this\",\"desc\":\"\",\"href\":\"\"},{\"name\":\"14 to 15 years\",\"price\":\"£530\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=14 to 15 years\",\"cta\":\"Book this\",\"desc\":\"\",\"href\":\"\"},{\"name\":\"16 to 17 years\",\"price\":\"£630\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=16 to 17 years\",\"cta\":\"Book this\",\"desc\":\"\",\"href\":\"\"}]} /-->\n\n<!-- wp:group {\"className\":\"body-text\"} -->\n<div class=\"wp-block-group body-text\"><!-- wp:paragraph -->\n<p><p class=\"muted\" style=\"margin-top:22px;font-size:15px\">\n      Children with medical/foreskin problems: contact the clinic for a quote. See\n      <a href=\"https://circumcision-london-wp.vercel.app/babies/\" style=\"color:var(--blue-deep)\">babies and toddlers</a> or\n      <a href=\"https://circumcision-london-wp.vercel.app/children/\" style=\"color:var(--blue-deep)\">children and teenagers</a>.\n    </p></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div></section>\n<!-- /wp:cil/section -->\n\n<!-- wp:cil/section -->\n<section class=\"wp-block-cil-section section-sm\"><div class=\"wrap\"><!-- wp:cil/section-head {\"heading\":\"Adults\",\"lede\":\"Adult circumcision with no medical/foreskin problem, with frenulum removal, or with a medical/foreskin problem +/- frenulum removal.\"} /-->\n\n<!-- wp:cil/price-table {\"rows\":[{\"name\":\"Adult circumcision, no medical or foreskin problem\",\"desc\":\"Forceps guided method, closed with stitches and glue.\",\"price\":\"£680\",\"href\":\"https://circumcision-london-wp.vercel.app/adults/\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=Adult circumcision, no medical or foreskin problem\",\"cta\":\"Book this\"},{\"name\":\"Adult circumcision with removal of the frenulum\",\"desc\":\"Where the frenulum is short or tethering, it is dealt with in the same procedure. Stitches and glue.\",\"price\":\"£880\",\"href\":\"https://circumcision-london-wp.vercel.app/procedures/frenuloplasty/\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=Adult circumcision with removal of the frenulum\",\"cta\":\"Book this\"},{\"name\":\"Adult circumcision with a medical or foreskin problem\",\"desc\":\"Phimosis, scarring or BXO, with or without removal of the frenulum. Stitches and glue.\",\"price\":\"£1,080\",\"href\":\"https://circumcision-london-wp.vercel.app/conditions/phimosis/\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=Adult circumcision with a medical or foreskin problem\",\"cta\":\"Book this\"}]} /--></div></section>\n<!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"band\":\"bg-card edge\"} -->\n<section class=\"wp-block-cil-section section-sm bg-card edge\"><div class=\"wrap\"><!-- wp:cil/section-head {\"heading\":\"Quoted separately\"} /-->\n\n<!-- wp:cil/price-table {\"rows\":[{\"name\":\"Children with a medical or foreskin problem\",\"desc\":\"Priced after examination, because what is involved varies a great deal.\",\"price\":\"Contact us for a quote\",\"href\":\"https://circumcision-london-wp.vercel.app/children/\",\"cta\":\"Enquire\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=Children with a medical or foreskin problem\"},{\"name\":\"Re-circumcision and revision\",\"desc\":\"Tidying up a circumcision done elsewhere: scar revision, tightening a loose result. Usually needs a consultation first.\",\"price\":\"Contact us for a quote\",\"href\":\"https://circumcision-london-wp.vercel.app/re-circumcision/\",\"cta\":\"Enquire\",\"url\":\"https://circumcision-london-wp.vercel.app/book/?for=Re-circumcision and revision\"},{\"name\":\"IV sedation for nervous patients\",\"desc\":\"Call the clinic. The clinic liaises with the anaesthetist and arranges the appointment separately. This is not an online booking add-on.\",\"price\":\"Extra £800\",\"cta\":\"Call the clinic\",\"url\":\"tel:+442089513794\",\"href\":\"\"}]} /--></div></section>\n<!-- /wp:cil/section -->\n\n<!-- wp:cil/cta-band {\"title\":\"Not sure which band applies?\",\"text\":\"Call and tell us the age, or describe the problem, and we will tell you the figure.\"} /-->"
