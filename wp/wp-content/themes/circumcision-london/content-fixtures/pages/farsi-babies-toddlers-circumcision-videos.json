    "content": "<!-- wp:cil/page-head {\"eyebrow\":\"Aftercare videos · 0–2y · Farsi - فارسی\",\"title\":\"Farsi translation Babies and Toddlers (0-2 years old)\",\"lede\":\"Below are a few videos which we would like you to watch. They include a consultation explaining what to expect on the day of circumcision, aftercare video for the ring method, how to change the nappy and an explanation of how to clean the penis after the ring comes off. Please note that every patient is different and whilst this explanation will apply to 99% of patients, if there is anything different which your son may need, we will advise you accordingly.\",\"crumbs\":[{\"label\":\"Aftercare\",\"href\":\"/aftercare/\"},{\"label\":\"0–2y\",\"href\":\"/babies-toddlers-circumcision-videos/\"},{\"label\":\"Farsi - فارسی\",\"href\":\"\"}]} /-->\n\n<!-- wp:cil/section {\"size\":\"section-sm\",\"band\":\"\",\"wrap\":\"wrap\"} --><section class=\"wp-block-cil-section section-sm\"><div class=\"wrap\"><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:paragraph --><p><span lang=\"fa\" dir=\"rtl\"><strong>ترجمه فارسی نوزادان و کودکان نوپا (0-2 سال)</strong></span></p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Please also note that this translation has been carried out using computer software and we cannot guarantee the accuracy of the translation, so please also refer to the main English videos.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><span lang=\"fa\" dir=\"rtl\">در زیر چند ویدیو وجود دارد که مایلیم آنها را تماشا کنید. آنها شامل مشاوره در مورد آنچه در روز ختنه باید انتظار داشته باشید، فیلم مراقبت بعد از روش (حلقه)، نحوه تعویض پوشک و توضیح نحوه تمیز کردن آلت تناسلی پس از جدا شدن حلقه را شامل می شود. لطفاً توجه داشته باشید که هر بیمار متفاوت است و در حالی که این توضیح برای 99٪ بیماران اعمال می شود، اگر فرزند شما به چیز دیگری نیاز داشته باشد، ما به شما توصیه می کنیم.</span></p><!-- /wp:paragraph --><!-- wp:paragraph --><p><span lang=\"fa\" dir=\"rtl\">همچنین توجه داشته باشید که این ترجمه با استفاده از نرم افزار کامپیوتری انجام شده است و ما نمی توانیم صحت ترجمه را تضمین کنیم، بنابراین لطفا به ویدیوهای اصلی انگلیسی نیز مراجعه کنید.</span></p><!-- /wp:paragraph --></div><!-- /wp:group --></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-navy\",\"wrap\":\"wrap\",\"anchor\":\"videos\"} --><section class=\"wp-block-cil-section section bg-navy\" id=\"videos\"><div class=\"wrap\"><!-- wp:cil/section-head {\"eyebrow\":\"Aftercare videos · 0–2y · Farsi - فارسی\",\"heading\":\"Videos for babies and toddlers\",\"display\":\"d-2\"} /--><!-- wp:cil/video-grid {\"items\":[{\"title\":\"Preparation for circumcision\",\"description\":\"\\u003cspan lang=\\u0022fa\\u0022 dir=\\u0022rtl\\u0022\\u003eآمادگی برای ختنه\\u003c/span\\u003e\",\"duration\":\"1:46\",\"mediaKey\":\"aftercare/videos/farsi/preparation.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/fa-preparation.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"Consultation\",\"description\":\"\\u003cspan lang=\\u0022fa\\u0022 dir=\\u0022rtl\\u0022\\u003eمشاوره\\u003c/span\\u003e\",\"duration\":\"3:09\",\"mediaKey\":\"aftercare/videos/farsi/consultation.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/fa-consultation.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"ring method aftercare instructions\",\"description\":\"\\u003cspan lang=\\u0022fa\\u0022 dir=\\u0022rtl\\u0022\\u003eمراقبت های بعدی دستورالعمل ها\\u003c/span\\u003e\",\"duration\":\"2:32\",\"mediaKey\":\"aftercare/videos/farsi/ring-method-aftercare.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/fa-ring-method-aftercare.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"How to apply Vaseline to the Nappy\",\"description\":\"\\u003cspan lang=\\u0022fa\\u0022 dir=\\u0022rtl\\u0022\\u003eنحوه زدن وازلین روی پوشک\\u0