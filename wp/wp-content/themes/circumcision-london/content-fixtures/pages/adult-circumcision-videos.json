    "content": "<!-- wp:cil/page-head {\"eyebrow\":\"Aftercare videos \u00b7 14+ yrs and adults\",\"title\":\"14+ years old and Adults\",\"lede\":\"Below are a few videos which we would like you to watch. They include a consultation explaining what to expect on the day of circumcision, aftercare video for the Forceps guided (traditional) method and how to apply Vaseline when wearing underwear. Please note that every patient is different and whilst this explanation will apply to 99% of patients, if there is anything different, we will advise you accordingly.\",\"crumbs\":[{\"label\":\"Aftercare\",\"href\":\"/aftercare/\"},{\"label\":\"14+ yrs and adults\",\"href\":\"\"}]} /-->\n\n<!-- wp:cil/section {\"size\":\"section-sm\",\"band\":\"bg-card edge\",\"wrap\":\"wrap\",\"anchor\":\"aftercare-sheets\"} --><section class=\"wp-block-cil-section section-sm bg-card edge\" id=\"aftercare-sheets\"><div class=\"wrap\"><!-- wp:cil/section-head {\"eyebrow\":\"Aftercare sheets\",\"heading\":\"Download our aftercare instructions sheet\",\"lede\":\"You will be given this aftercare sheet after the circumcision but you can also download it by clicking on the link below:\",\"display\":\"d-3\"} /--><!-- wp:cil/file-link {\"text\":\"Forceps guided (adults) aftercare instructions sheet\",\"mediaKey\":\"aftercare/documents/forceps-guided-adults-aftercare-sheet.pdf\"} /--></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-navy\",\"wrap\":\"wrap\",\"anchor\":\"videos\"} --><section class=\"wp-block-cil-section section bg-navy\" id=\"videos\"><div class=\"wrap\"><!-- wp:cil/section-head {\"eyebrow\":\"Aftercare videos \u00b7 14+ yrs and adults\",\"heading\":\"Videos for teenagers and adults\",\"display\":\"d-2\"} /--><!-- wp:cil/video-grid {\"items\":[{\"title\":\"Preparation for circumcision\",\"description\":\"\",\"duration\":\"0:42\",\"mediaKey\":\"aftercare/videos/preparation-14-adults.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/preparation-14-adults.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0}],\"layout\":\"list\",\"itemLevel\":3,\"showHead\":false} /--><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"cil-aftercare-checklist\"} --><figure class=\"wp-block-image size-large cil-aftercare-checklist\"><img src=\"/wp-content/themes/circumcision-london/assets/images/aftercare/checklist-14-adults.jpg\" alt=\"Circumcision Checklist 14+ years old &amp; Adults: Fill out the consent form sent you by email. Bring IDs for patient (under 18 years old also need mother\u2019s and father\u2019s ID). Tight underwear. Shave clean the pubic hair. Paracetamol. Vaseline - 250ml.\"/><figcaption class=\"wp-element-caption\">Circumcision checklist, 14+ years old &amp; adults</figcaption></figure><!-- /wp:image --><!-- wp:cil/video-grid {\"items\":[{\"title\":\"Consultation\",\"description\":\"\",\"duration\":\"3:22\",\"mediaKey\":\"aftercare/videos/consultation-14-adults.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/consultation-14-adults.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"Adult Forceps guided (traditional) method aftercare instructions\",\"description\":\"\",\"duration\":\"3:54\",\"mediaKey\":\"aftercare/videos/forceps-aftercare-adults.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/forceps-aftercare-adults.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"How to apply vaseline when wearing underwear\",\"description\":\"\",\"duration\":\"1:30\",\"mediaKey\":\"aftercare/videos/vaseline-underwear.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/vaseline-underwear.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"How to stop bleeding\",\"description\":\"\",\"duration\":\"1:04\",\"mediaKey\":\"aftercare/videos/stop-bleeding.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/stop-bleeding.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0}],\"layout\":\"list\",\"itemLevel\":3,\"showHead\":false} /--></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-card edge\",\"wrap\":\"wrap\"} --><section class=\"wp-block-cil-section section bg-card edge\"><div class=\"wrap\"><!-- wp:cil/section-head {\"eyebrow\":\"Patients\",\"heading\":\"In their own words\",\"display\":\"d-2\"} /--><!-- wp:cil/quotes-grid {\"quotes\":[{\"name\":\"Sam\",\"context\":\"36 years old\",\"quote\":\"I am a health professional who has, and continues to work with many health professionals from all over the world. I can confidently say Dr Al-Ali and his very efficient assistant are easily some of the best practitioners in the business. I underwent the circumcision yesterday, I have to admit I was anxious before the procedure. Dr Al-Ali and his assistant took time to explain the procedure answer all my questions and allay my anxiety. They told me it was going to be painless. He administered the local anaesthesia, and he asked me I could feel my penis, I couldn\u2019t, all the sensation was gone. He started the procedure and it was totally painless, I even fell asleep at some point. The procedure was successful, I drove home thereafter. Even after the local anaesthesia had worn off, it was totally painless. As I write this comment, I am in day 1 after the operation, I am pain free, I will be going out to do some shopping in a minute. Dr Al-Ali and your very good assistant keep up the good.\"},{\"name\":\"Giles\",\"context\":\"32 years old\",\"quote\":\"Cannot recommend this place enough. I was certainly concerned about having the procedure done as any guy my age would be. The sheer clinical efficiency and professional standards of Dr Al-ali and his staff put me completely at ease. Post procedure of course is no walk in the park, there is tenderness that one would expect with this sort of operation. But the dressing and instructions from the team made this time so much easier. I didn't miss a day of work thanks to this, nor did I feel I couldn't be active through the day (although I did miss football for a 4 weeks, but this was to be expected!) All in all 5 months later there is no scaring and no worries, would 100% recommend this practice.\"}],\"perPage\":0} /--></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-warm\",\"wrap\":\"wrap\"} --><section class=\"wp-block-cil-section section bg-warm\"><div class=\"wrap\"><!-- wp:cil/section-head {\"eyebrow\":\"Aftercare\",\"heading\":\"Videos for other age groups\",\"display\":\"d-2\"} /--><!-- wp:cil/group-cards {\"level\":3,\"banded\":false,\"items\":[{\"href\":\"/babies-toddlers-circumcision-videos/\",\"age\":\"Babies and toddlers\",\"title\":\"0\u20132y\",\"price\":\"\",\"blurb\":\"\",\"cta\":\"Watch the 0\u20132y videos\"},{\"href\":\"/children-circumcision-videos/\",\"age\":\"Children\",\"title\":\"3\u201313y\",\"price\":\"\",\"blurb\":\"\",\"cta\":\"Watch the 3\u201313y videos\"},{\"href\":\"/adult-circumcision-videos/\",\"age\":\"Teenagers and adults\",\"title\":\"14+ yrs and adults\",\"price\":\"\",\"blurb\":\"\",\"cta\":\"Watch the 14+ yrs and adults videos\"}]} /--></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/cta-band {\"title\":\"If you have further questions\",\"text\":\"<p>If you have further questions, you can either <a href=\\\"tel:+442089513794\\\">call us</a> or <a href=\\\"#request-callback\\\">request for us to call you back</a>. You can also send us an email enquiry or speak to us via Whatsapp.</p><p class=\\\"cil-cta-contacts\\\"><a class=\\\"cil-cta-contact cil-cta-contact--email\\\" href=\\\"mailto:info@circumcisioninlondon.co.uk\\\"><span class=\\\"cil-cta-contact__label\\\">Email</span>info@circumcisioninlondon.co.uk</a><a class=\\\"cil-cta-contact cil-cta-contact--whatsapp\\\" href=\\\"https://wa.me/447886779958\\\" rel=\\\"noop