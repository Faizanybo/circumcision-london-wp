    "content": "<!-- wp:cil/page-head {\"eyebrow\":\"About us\",\"title\":\"About Circumcision in London\",\"lede\":\"Welcome to Circumcision in London, offering you professional services baby/ infant, children and adult circumcisions. Our circumcision practitioners have carried out thousands of successful circumcision for all ages. All circumcision are carried out under local anaesthetic to make sure the circumcision is pain-free throughout. We also give a comprehensive aftercare to make sure the patients and parents know exactly what to do to make the healing process as comfortable as possible.\",\"crumbs\":[{\"label\":\"About\",\"href\":\"\"}]} /-->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-card edge\",\"wrap\":\"wrap\",\"anchor\":\"clinic\"} --><section class=\"wp-block-cil-section section bg-card edge\" id=\"clinic\"><div class=\"wrap\"><!-- wp:cil/split {\"reverse\":false} --><div class=\"wp-block-cil-split split\"><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:heading {\"level\":2,\"className\":\"display d-2\"} --><h2 class=\"wp-block-heading display d-2\">London Circumcision Clinic</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"cil-checklist\"} --><ul class=\"cil-checklist wp-block-list\"><!-- wp:list-item --><li>Patient can wear all clothes</li><!-- /wp:list-item --><!-- wp:list-item --><li>Patient can walk normally immediately</li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"https://circumcision-london-wp.vercel.app/babies/\">Baby and infant Circumcision</a></li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"https://circumcision-london-wp.vercel.app/children/\">Child Circumcision</a></li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"https://circumcision-london-wp.vercel.app/adults/\">Adult Circumcision</a></li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:group --><!-- wp:cil/figure {\"name\":\"waiting-room\"} /--></div><!-- /wp:cil/split --></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"\",\"wrap\":\"wrap\",\"anchor\":\"practitioners\"} --><section class=\"wp-block-cil-section section\" id=\"practitioners\"><div class=\"wrap\"><!-- wp:cil/video-grid {\"items\":[{\"title\":\"Meet our Circumcision Practitioners\",\"description\":\"Our two practitioners have more than 40 years of combined experience in the UK and abroad and have carried out thousands of circumcisions across different age groups.\",\"duration\":\"0:27\",\"mediaKey\":\"about/meet-our-circumcision-practitioners.mp4\",\"poster\":\"https://circumcision-london-wp.vercel.app/wp-content/themes/circumcision-london/assets/images/about/meet-our-circumcision-practitioners.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0}],\"layout\":\"list\",\"itemLevel\":2,\"showHead\":false} /--><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:paragraph --><p>The clinic's work includes baby and infant circumcision, circumcision for children and teenagers, adult circumcision, medical foreskin problems, re-circumcision and practitioner training.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Procedures are carried out in a dedicated clinical environment with attention to infection control, consent, anaesthesia, aftercare and follow-up.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><a href=\"https://circumcision-london-wp.vercel.app/team/\">Meet the practitioners →</a></p><!-- /wp:paragraph --></div><!-- /wp:group --></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-warm\",\"wrap\":\"wrap\",\"anchor\":\"why-choose-us\"} --><section class=\"wp-block-cil-section section bg-warm\" id=\"why-choose-us\"><div class=\"wrap\"><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:heading {\"level\":2,\"className\":\"display d-2\"} --><h2 class=\"wp-block-heading display d-2\">Why Choose Us?</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"cil-checklist\"} --><ul class=\"cil-checklist wp-block-list\"><!-- wp:list-item --><li>Experienced - over 40 years of combined experience between the 2 practitioners</li><!-- /wp:list-item --><!-- wp:list-item --><li>Hygienic and modern clinic</li><!-- /wp:list-item --><!-- wp:list-item --><li>Care Quality Commission (CQC) registered</li><!-- /wp:list-item --><!-- wp:list-item --><li>Plastibell/ Circumplast (ring) and Forceps Guided (traditional) methods used accordingly</li><!-- /wp:list-item --><!-- wp:list-item --><li>Comprehensive aftercare</li><!-- /wp:list-item --><!-- wp:list-item --><li>Simple but thorough aftercare sheet given</li><!-- /wp:list-item --><!-- wp:list-item --><li>GP letter given to update medical records</li><!-- /wp:list-item --><!-- wp:list-item --><li>School and work letters given if needed</li><!-- /wp:list-item --><!-- wp:list-item --><li>Free street parking - plenty of spaces</li><!-- /wp:list-item --><!-- wp:list-item --><li>Easy commute - no Congestion Charge</li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:group --></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/cta-band {\"title\":\"Book a consultation\",\"text\":\"You can request a consultation or book by contacting the clinic. Tell us about any medical conditions, medication, allergies or bleeding problems when you book.\",\"eyebrow\":\"Talk to us\",\"ctaLabel\":\"Book a consultation\",\"ctaUrl\":\"https://circumcision-london-wp.vercel.app/book/\",\"phoneLabel\":\"Call 020 8951 3794\",\"phoneUrl\":\"tel:+442089513794\",\"cardTitle\":\"Would you rather write than speak?\",\"cardHtml\":\"\\u003cp style=\\u0022margin-top:10px\\u0022\\u003eA phone call asks you to be fluent and composed in the moment. \\u003ca href=\\u0022https://wa.me/447886779958\\u0022 rel=\\u0022noopener\\u0022 target=\\u0022_blank\\u0022 data-track=\\u0022whatsapp-cta\\u0022 style=\\u0022color:var(\\u002d\\u002dblue-deep)\\u0022\\u003eWhatsApp\\u003c/a\\u003e does not. You can take your time, translate, and forward the answer to whoever else in the family needs to see it.\\u003c/p\\u003e\\u003cp style=\\u0022margin-top:12px\\u0022\\u003eWe reply during opening hours, and we are used to the questions people feel awkward asking out loud.\\u003c/p\\u003e\"} /-->"
