    "content": "<!-- wp:cil/page-head {\"eyebrow\":\"About us\",\"title\":\"About Circumcision in London\",\"lede\":\"Welcome to Circumcision in London, offering you professional services baby/ infant, children and adult circumcisions. Our circumcision practitioners have carried out thousands of successful circumcision for all ages. All circumcision are carried out under local anaesthetic to make sure the circumcision is pain-free throughout. We also give a comprehensive aftercare to make sure the patients and parents know exactly what to do to make the healing process as comfortable as possible.\",\"crumbs\":[{\"label\":\"About\",\"href\":\"\"}]} /-->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"\",\"wrap\":\"wrap\",\"anchor\":\"practitioners\"} --><section class=\"wp-block-cil-section section\" id=\"practitioners\"><div class=\"wrap\"><!-- wp:cil/video-grid {\"items\":[{\"title\":\"Meet our Circumcision Practitioners\",\"description\":\"Our two practitioners have more than 40 years of combined experience in the UK and abroad and have carried out thousands of circumcisions across different age groups.\",\"duration\":\"0:27\",\"mediaKey\":\"about/meet-our-circumcision-practitioners.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/about/meet-our-circumcision-practitioners.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0}],\"layout\":\"list\",\"itemLevel\":2,\"showHead\":false} /--><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:paragraph --><p>The clinic's work includes baby and infant circumcision, circumcision for children and teenagers, adult circumcision, medical foreskin problems, re-circumcision and practitioner training.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Procedures are carried out in a dedicated clinical environment with attention to infection control, consent, anaesthesia, aftercare and follow-up.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><a href=\"/team/\">Meet the practitioners \u2192</a></p><!-- /wp:paragraph --></div><!-- /wp:group --></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-navy\",\"wrap\":\"wrap\",\"anchor\":\"clinic\"} --><section class=\"wp-block-cil-section section bg-navy\" id=\"clinic\"><div class=\"wrap\"><!-- wp:cil/split {\"reverse\":false} --><div class=\"wp-block-cil-split split\"><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:heading {\"level\":2,\"className\":\"display d-2\"} --><h2 class=\"wp-block-heading display d-2\">London Circumcision Clinic</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"cil-checklist\"} --><ul class=\"cil-checklist wp-block-list\"><!-- wp:list-item --><li>Patient can wear all clothes</li><!-- /wp:list-item --><!-- wp:list-item --><li>Patient can walk normally immediately</li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"/babies/\">Baby and infant Circumcision</a></li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"/children/\">Child Circumcision</a></li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"/adults/\">Adult Circumcision</a></li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:group --><!-- wp:cil/figure {\"name\":\"waiting-room\"} /--></div><!-- /wp:cil/split --></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-warm\",\"wrap\":\"wrap\",\"anchor\":\"why-choose-us\"} --><section class=\"wp-block-cil-section section bg-warm\" id=\"why-choose-us\"><div class=\"wrap\"><!-- wp:group {\"className\":\"body-text\"} --><div class=\"wp-block-group body-text\"><!-- wp:heading {\"level\":2,\"className\":\"display d-2\"} --><h2 class=\"wp-block-heading display d-2\">Why Choose Us?</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"cil-checklist\"} --><ul class=\"cil-checklist wp-block-list\"><!-- wp:list-item --><li>Experienced - over 40 years of combined experience between the 2 practitioners</li><!-- /wp:list-item --><!-- wp:list-item --><li>Hygienic and modern clinic</li><!-- /wp:list-item --><!-- wp:list-item --><li>Care Quality Commission (CQC) registered</li><!-- /wp:list-item --><!-- wp:list-item --><li>Plastibell/ Circumplast (ring) and Forceps Guided (traditional) methods used accordingly</li><!-- /wp:list-item --><!-- wp:list-item --><li>Comprehensive aftercare</li><!-- /wp:list-item --><!-- wp:list-item --><li>Simple but thorough aftercare sheet given</li><!-- /wp:list-item --><!-- wp:list-item --><li>GP letter given to update medical records</li><!-- /wp:list-item --><!-- wp:list-item --><li>School and work letters given if needed</li><!-- /wp:list-item --><!-- wp:list-item --><li>Free street parking - plenty of spaces</li><!-- /wp:list-item --><!-- wp:list-item --><li>Easy commute - no Congestion Charge</li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:group --></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/cta-band {\"title\":\"If you have further questions\",\"text\":\"<p>If you have further questions, you can either <a href=\\\"tel:+442089513794\\\">call us</a> or <a href=\\\"#request-callback\\\">request for us to call you back</a>. You can also send us an email enquiry or speak to us via Whatsapp.</p><p class=\\\"cil-cta-contacts\\\"><a class=\\\"cil-cta-contact cil-cta-contact--email\\\" href=\\\"mailto:info@circumcisioninlondon.co.uk\\\"><span class=\\\"cil-cta-contact__label\\\">Email</span>info@circumcisioninlondon.co.uk</a><a class=\\\"cil-cta-contact cil-cta-contact--whatsapp\\\" href=\\\"https://wa.me/447886779958\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" data-track=\\\"whatsapp-cta\\\"><span class=\\\"cil-cta-contact__label\\\">WhatsApp</span>07886779958</a></p>\",\"eyebrow\":\"Talk to us\",\"ctaLabel\":\"Book online\",\"ctaUrl\":\"/book/\",\"phoneLabel\":\"Call 020 8951 3794\",\"phoneUrl\":\"tel:+442089513794\",\"cardTitle\":\"\",\"cardHtml\":\"\",\"cardEyebrow\":\"Request a call back\",\"showCallback\":true,\"formId\":\"about\",\"formSubject\":\"about page callback\",\"callbackAnchor\":\"request-callback\",\"nameLabel\":\"Your name\",\"phoneFieldLabel\":\"Phone number\",\"dobLabel\":\"Patient DOB\",\"messageLabel\":\"Anything you would like us to know\",\"optionalLabel\":\"(optional)\",\"consentHtml\":\"I am happy for the clinic to contact me about this enquiry. We do not add you to a mailing list. See our <a href=\\\"/privacy-notice/\\\" style=\\\"color:var(--blue-deep)\\\">privacy notice</a>.\",\"submitLabel\":\"Request a call back\",\"invalidMessage\":\"Please complete the highlighted field.\",\"sentMessage\":\"Opening your email app so this reaches the clinic. If nothing happens, call 020 8951 3794.\"} /-->"
