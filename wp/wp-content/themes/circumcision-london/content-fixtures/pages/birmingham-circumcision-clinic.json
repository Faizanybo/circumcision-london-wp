    "content": "<!-- wp:cil/page-head {\"eyebrow\":\"Birmingham · Phone booking\",\"title\":\"Circumcision Clinic in Birmingham\",\"lede\":\"We are pleased to announce the expansion of our Male Circumcision service to our new Birmingham Clinic. With many years of experience, we continue to provide the same high-quality Circumcision service and patient care. Please note that Birmingham prices differ from our London clinic prices. Call us today to find out more information (please do not use the online booking system, as this is currently available for the London clinic only).\",\"crumbs\":[{\"label\":\"Visit us\",\"href\":\"https://circumcision-london-wp.vercel.app/contact/\"},{\"label\":\"Birmingham\",\"href\":\"\"}]} /-->\n\n<!-- wp:cil/section {\"size\":\"section-sm\",\"band\":\"\",\"wrap\":\"wrap\"} --><section class=\"wp-block-cil-section section-sm\"><div class=\"wrap\"><!-- wp:html --><div class=\"grid g-3\">\n      <div class=\"card\" data-reveal>\n        <span class=\"caps eyebrow\">Where we are</span>\n        <h2 class=\"display d-3\">Birmingham clinic</h2>\n        <p class=\"muted\" style=\"margin-top:8px;font-size:15px\">Circumcision in Birmingham - Beverley Clinic</p>\n        <address style=\"font-style:normal;margin-top:16px;font-size:17px;line-height:1.8;color:var(--muted)\">Soho Health Centre<br>Louise Road<br>Birmingham<br>B21 9RY<br></address>\n      </div>\n      <div class=\"card\" data-reveal data-reveal-delay=\"80\">\n        <span class=\"caps eyebrow\">Book this clinic</span>\n        <h2 class=\"display d-3\">Phone booking only</h2>\n        <p style=\"margin-top:14px\">Call <a href=\"tel:03301334535\" data-track=\"birmingham-call\" style=\"color:var(--blue-deep);font-weight:600\">0330 133 4535</a> and state that you want the Birmingham clinic. Online booking is currently available for the London clinic only.</p>\n        <div class=\"btn-row\" style=\"margin-top:20px\">\n          <a class=\"btn\" href=\"tel:03301334535\" data-track=\"birmingham-call-btn\">Call 0330 133 4535</a>\n        </div>\n      </div>\n      <div class=\"card\" data-reveal data-reveal-delay=\"160\">\n        <span class=\"caps eyebrow\">Prices</span>\n        <h2 class=\"display d-3\">Different from London</h2>\n        <p style=\"margin-top:14px\">Birmingham prices differ from our London clinic prices. Call us to find out more.</p>\n        <p class=\"muted\" style=\"margin-top:14px;font-size:15px\"><a href=\"mailto:info@circumcisioninlondon.co.uk\" style=\"color:var(--blue-deep);text-decoration:none\">info@circumcisioninlondon.co.uk</a></p>\n      </div>\n    </div><!-- /wp:html --></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-card edge\",\"wrap\":\"wrap-narrow\"} --><section class=\"wp-block-cil-section section bg-card edge\"><div class=\"wrap-narrow\"><!-- wp:cil/callout {\"title\":\"How to book this clinic\",\"body\":\"Give us a call now on \\u003ca href=\\u0022tel:03301334535\\u0022\\u003e0330 133 4535\\u003c/a\\u003e and please state that you would like to book the circumcision into the Birmingham clinic instead of the London clinic. Please do not use the online booking system, as this is currently available for the London clinic only.\",\"level\":2} /--></div></section><!-- /wp:cil/section -->"
