rcare/videos/arabic/vaseline-nappy.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/ar-vaseline-nappy.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"How to burp the baby\",\"description\":\"\\u003cspan lang=\\u0022ar\\u0022 dir=\\u0022rtl\\u0022\\u003eكيفية تجشؤ الطفل\\u003c/span\\u003e\",\"duration\":\"0:17\",\"mediaKey\":\"aftercare/videos/arabic/burp-baby.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/ar-burp-baby.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"How to clean the penis after the ring comes off\",\"description\":\"\\u003cspan lang=\\u0022ar\\u0022 dir=\\u0022rtl\\u0022\\u003eكيفية تنظيف القضيب بعد سقوط الحلقة\\u003c/span\\u003e\",\"duration\":\"2:35\",\"mediaKey\":\"aftercare/videos/arabic/clean-penis.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/ar-clean-penis.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0}],\"layout\":\"list\",\"itemLevel\":3,\"showHead\":false} /--></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-warm\",\"wrap\":\"wrap\"} --><section class=\"wp-block-cil-section section bg-warm\"><div class=\"wrap\"><!-- wp:cil/section-head {\"eyebrow\":\"Aftercare\",\"heading\":\"Videos for other age groups\",\"display\":\"d-2\"} /--><!-- wp:cil/group-cards {\"level\":3,\"banded\":false,\"items\":[{\"href\":\"/babies-toddlers-circumcision-videos/\",\"age\":\"Babies and toddlers\",\"title\":\"0–2y\",\"price\":\"12 videos\",\"blurb\":\"Preparation, consultation, ring method aftercare, applying Vaseline to the nappy, burping, cleaning and the aftercare sheets.\",\"cta\":\"Watch the 0–2y videos\"},{\"href\":\"/children-circumcision-videos/\",\"age\":\"Children\",\"title\":\"3–13y\",\"price\":\"8 videos\",\"blurb\":\"Preparation, consultation, forceps guided aftercare, applying Vaseline with underwear, cleaning and the aftercare sheet.\",\"cta\":\"Wat