    "content": "<!-- wp:cil/page-head {\"eyebrow\":\"Aftercare videos \u00b7 3\u201313y\",\"title\":\"Children 3-13 years old\",\"lede\":\"Below are a few videos which we would like you to watch. They include a consultation explaining what to expect on the day of circumcision, aftercare video for the Forceps guided (traditional) method, how to apply the Vaseline when wearing underwear and an explanation of buried penis which some patients may already have or develop in the future. Please note that every patient is different and whilst this explanation will apply to the majority of patients, if there is anything different which your son may need, we will advise you accordingly.\",\"crumbs\":[{\"label\":\"Aftercare\",\"href\":\"/aftercare/\"},{\"label\":\"3\u201313y\",\"href\":\"\"}]} /-->\n\n<!-- wp:cil/section {\"size\":\"section-sm\",\"band\":\"bg-card edge\",\"wrap\":\"wrap\",\"anchor\":\"aftercare-sheets\"} --><section class=\"wp-block-cil-section section-sm bg-card edge\" id=\"aftercare-sheets\"><div class=\"wrap\"><!-- wp:cil/section-head {\"eyebrow\":\"Aftercare sheets\",\"heading\":\"Download our aftercare instructions sheet\",\"lede\":\"You will be given this aftercare sheet after the circumcision but you can also download it by clicking on the link below:\",\"display\":\"d-3\"} /--><!-- wp:cil/file-link {\"text\":\"Forceps guided (children) aftercare instructions sheet\",\"mediaKey\":\"aftercare/documents/forceps-guided-children-aftercare-sheet.pdf\"} /--></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-navy\",\"wrap\":\"wrap\",\"anchor\":\"videos\"} --><section class=\"wp-block-cil-section section bg-navy\" id=\"videos\"><div class=\"wrap\"><!-- wp:cil/section-head {\"eyebrow\":\"Aftercare videos \u00b7 3\u201313y\",\"heading\":\"Videos for children aged 3 to 13\",\"display\":\"d-2\"} /--><!-- wp:cil/video-grid {\"items\":[{\"title\":\"Preparation for circumcision\",\"description\":\"\",\"duration\":\"1:11\",\"mediaKey\":\"aftercare/videos/preparation-3-13.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/preparation-3-13.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0}],\"layout\":\"list\",\"itemLevel\":3,\"showHead\":false} /--><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"cil-aftercare-checklist\"} --><figure class=\"wp-block-image size-large cil-aftercare-checklist\"><img src=\"/wp-content/themes/circumcision-london/assets/images/aftercare/checklist-3-13.jpg\" alt=\"Circumcision Checklist 3-13 years old: Fill out the consent form sent you by email. Bring IDs for your son, mother and father. Tight underwear. Children above 10 years old - please shave clean any pubic hair. Calpol depending on the age. Vaseline - 250ml.\"/><figcaption class=\"wp-element-caption\">Circumcision checklist, 3-13 years old</figcaption></figure><!-- /wp:image --><!-- wp:cil/video-grid {\"items\":[{\"title\":\"Consultation\",\"description\":\"\",\"duration\":\"2:25\",\"mediaKey\":\"aftercare/videos/consultation-3-13.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/consultation-3-13.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"Children Forceps guided (traditional) method aftercare instructions\",\"description\":\"\",\"duration\":\"3:22\",\"mediaKey\":\"aftercare/videos/forceps-aftercare-children.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/forceps-aftercare-children.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"How to apply vaseline when putting on underwear\",\"description\":\"\",\"duration\":\"1:30\",\"mediaKey\":\"aftercare/videos/vaseline-underwear.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/vaseline-underwear.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"How to clean the penis (buried penis or normal penis)\",\"description\":\"\",\"duration\":\"0:54\",\"mediaKey\":\"aftercare/videos/clean-penis.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/clean-penis.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"How to separate skin adhesions if they occur\",\"description\":\"\",\"duration\":\"0:58\",\"mediaKey\":\"aftercare/videos/skin-adhesions.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/skin-adhesions.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"How to stop bleeding\",\"description\":\"\",\"duration\":\"1:04\",\"mediaKey\":\"aftercare/videos/stop-bleeding.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/stop-bleeding.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0},{\"title\":\"Plastibell/ Circumplast (ring method) aftercare instructions.\",\"description\":\"This is not the common method for this age. please only watch this if you have been told by us. You can download the aftercare sheet by clicking \\u003ca href=\\u0022media:aftercare/documents/ring-method-aftercare-sheet.pdf\\u0022 rel=\\u0022noopener\\u0022 target=\\u0022_blank\\u0022\\u003ehere.\\u003c/a\\u003e\",\"duration\":\"4:54\",\"mediaKey\":\"aftercare/videos/ring-method-aftercare.mp4\",\"poster\":\"/wp-content/themes/circumcision-london/assets/images/aftercare/posters/ring-method-aftercare.jpg\",\"mp4\":\"\",\"posterId\":0,\"mp4Id\":0}],\"layout\":\"list\",\"itemLevel\":3,\"showHead\":false} /--></div></section><!-- /wp:cil/section -->\n\n<!-- wp:cil/section {\"size\":\"section\",\"band\":\"bg-warm\",\"wrap\":\"wrap\"} --><section class=\"wp-block-cil-section section bg-warm\"><div class=\"wrap\"><!-- wp:cil/section-head {\"eyebrow\":\"Aftercare\",\"heading\":\"Videos for other age groups\",\"display\":\"d-2\"} /--><!-- wp:cil/group-cards {\"level\":3,\"banded\":false,\"items\":[{\"href\":\"/babies-toddlers-circumcision-videos/\",\"age\":\"Babies and toddlers\",\"title\":\"0\u20132y\",\"price\":\