# Environment template. Copy values into LocalWP or the Vercel project
# environment. Do not commit filled files. Empty AUTH_* / *_SALT values let
# WordPress store per-site salts in the database. Setting or changing them
# invalidates all existing logins and cookies for that environment.

AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# Canonical URL for this environment (scheme + host, no trailing slash).
# Leave empty on Vercel staging if preview deployments must use their own host.
# Set on production only after explicit cutover approval.
WP_HOME=
WP_SITEURL=

# Optional extra hostnames, comma-separated, no scheme. Supports *.example.com.
WP_ALLOWED_HOSTS=
